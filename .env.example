# StablePulse frontend environment
# Copy to .env (git-ignored) and fill in as needed. Do not commit .env.

# Optional: override the API base URL at build time.
# Overrides runtime config? No: runtime window.STABLEPULSE_CONFIG.apiBase wins.
#   STABLEPULSE_API_BASE=https://your-worker.example.workers.dev
# Default when unset: dev http://127.0.0.1:8787, prod the StablePulse worker.

# ---------------------------------------------------------------------------
# AI API keys: NOT here. The AI narrative is generated in the Cloudflare
# Worker (separate repo), never in this frontend. Keys stay server-side.
#
# On the worker set these as secrets/env:
#   OPENAI_BASE_URL  e.g. https://openrouter.ai/api/v1
#   OPENAI_API_KEY   your key (use `wrangler secret put` or dashboard)
#   OPENAI_MODEL     e.g. deepseek/deepseek-chat
#
# This frontend only renders whatever the worker returns and degrades
# gracefully when AI is absent.
# ---------------------------------------------------------------------------
