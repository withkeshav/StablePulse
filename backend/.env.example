# StablePulse backend environment. Copy to backend/.env (git-ignored) and fill in.
# Never commit .env. All values below are placeholders.

# Server
# PORT=8787
# DATA_DIR=/opt/stablepulse/backend/data

# AI (OpenAI-compatible endpoint; e.g. OpenRouter, DeepSeek, or OpenAI)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_FALLBACK_MODEL=

# Minimum minutes between AI narrative generations (120 recommended).
# The ai job self-gates on this value, so a frequent crontab entry is safe.
# AI_CADENCE_MIN=120
